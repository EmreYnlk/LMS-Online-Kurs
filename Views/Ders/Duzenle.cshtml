@model LMSPlatform.ViewModels.DersViewModel
@{
    ViewData["Title"] = "Ders Düzenle";
}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-warning">
                <h4 class="mb-0"><i class="bi bi-pencil me-2"></i>Ders Düzenle</h4>
                <small>@Model.KursBaslik</small>
            </div>
            <div class="card-body">
                <form asp-action="Duzenle" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="KursId" />
                    <input type="hidden" asp-for="KursBaslik" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Baslik" class="form-label fw-bold"></label>
                        <input asp-for="Baslik" class="form-control" />
                        <span asp-validation-for="Baslik" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Aciklama" class="form-label fw-bold"></label>
                        <textarea asp-for="Aciklama" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="VideoUrl" class="form-label fw-bold"></label>
                        <input asp-for="VideoUrl" class="form-control" />
                        <span asp-validation-for="VideoUrl" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Sira" class="form-label fw-bold"></label>
                        <input asp-for="Sira" class="form-control" type="number" min="1" style="width:100px" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-check2 me-1"></i>Güncelle
                        </button>
                        <a asp-action="Index" asp-route-kursId="@Model.KursId" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
