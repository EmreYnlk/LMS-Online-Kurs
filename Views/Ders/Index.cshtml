@model IEnumerable<LMSPlatform.Models.Ders>
@{
    ViewData["Title"] = "Dersler";
    var kurs = ViewBag.Kurs as LMSPlatform.Models.Kurs;
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-play-circle me-2"></i>Dersler</h2>
        <p class="text-muted mb-0">@kurs?.Baslik</p>
    </div>
    <div>
        <a asp-action="Olustur" asp-route-kursId="@kurs?.Id" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Yeni Ders
        </a>
        <a asp-controller="Kurs" asp-action="Index" class="btn btn-outline-secondary ms-2">Geri</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Bu kursa henüz ders eklenmemiş.
        <a asp-action="Olustur" asp-route-kursId="@kurs?.Id" class="alert-link">İlk dersi ekleyin.</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Sıra</th>
                    <th>Başlık</th>
                    <th>Açıklama</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ders in Model.OrderBy(d => d.Sira))
                {
                    <tr>
                        <td><span class="badge bg-primary">@ders.Sira</span></td>
                        <td><strong>@ders.Baslik</strong></td>
                        <td class="text-muted">@(ders.Aciklama?.Length > 60 ? ders.Aciklama[..60] + "..." : ders.Aciklama ?? "-")</td>
                        <td>
                            <a asp-action="Duzenle" asp-route-id="@ders.Id" class="btn btn-sm btn-outline-warning">Düzenle</a>
                            <form asp-action="Sil" asp-route-id="@ders.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Bu dersi silmek istediğinizden emin misiniz?')">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
