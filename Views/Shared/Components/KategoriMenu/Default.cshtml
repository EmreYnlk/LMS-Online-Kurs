@model IEnumerable<LMSPlatform.Models.Kategori>
<ul class="list-unstyled mb-0">
    @foreach (var kat in Model)
    {
        <li>
            <a asp-controller="Home" asp-action="Index" asp-route-kategoriId="@kat.Id"
               class="text-white text-decoration-none d-flex justify-content-between py-1">
                <span><i class="bi bi-chevron-right me-1"></i>@kat.Ad</span>
                <span class="badge bg-white text-dark">@kat.Kurslar.Count</span>
            </a>
        </li>
    }
</ul>
