@model IEnumerable<LMSPlatform.Models.Kurs>
<div class="card mt-3">
    <div class="card-header bg-danger text-white">
        <i class="bi bi-fire me-1"></i>Popüler Kurslar
    </div>
    <div class="list-group list-group-flush">
        @foreach (var kurs in Model)
        {
            <a asp-controller="Kurs" asp-action="Detay" asp-route-id="@kurs.Id"
               class="list-group-item list-group-item-action py-2">
                <div class="d-flex align-items-start justify-content-between gap-2">
                    <small class="fw-bold" style="overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">@kurs.Baslik</small>
                    <small class="text-muted flex-shrink-0"><i class="bi bi-people me-1"></i>@kurs.AbonelikSayisi</small>
                </div>
                <small class="text-muted">@kurs.Egitmen?.TamAd</small>
            </a>
        }
    </div>
</div>
