<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="EduHub — Türkiye'nin en iyi online öğrenme platformu. Uzman eğitmenlerle yeni beceriler kazanın." />
    <title>@ViewData["Title"] — EduHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        // Init theme to prevent FOUC
        var storedTheme = localStorage.getItem('eduhub_theme') || 'midnight';
        document.documentElement.setAttribute('data-theme', storedTheme);
    </script>
</head>
<body>

<!-- ═══ NAVBAR ═══════════════════════════════════ -->
<nav class="navbar navbar-expand-lg" id="mainNav">
    <div class="container">
        <!-- Brand -->
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <div class="brand-logo-wrap">
                <img src="~/eduhub-logo.png" alt="EduHub Logo" />
            </div>
            <span class="brand-text">Edu<span>Hub</span></span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-label="Menü">
            <i class="bi bi-list"></i>
        </button>

        <div class="collapse navbar-collapse" id="navMenu">
            <!-- Left links -->
            <ul class="navbar-nav me-auto align-items-lg-center gap-1">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house"></i> Ana Sayfa
                    </a>
                </li>

                @if (User.IsInRole("Egitmen") || User.IsInRole("Admin"))
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-easel"></i> Eğitmen
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Kurs" asp-action="Index">
                                <i class="bi bi-collection-play"></i>Kurslarım
                            </a></li>
                            <li><a class="dropdown-item" asp-controller="Kurs" asp-action="Olustur">
                                <i class="bi bi-plus-circle"></i>Yeni Kurs
                            </a></li>
                        </ul>
                    </li>
                }

                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-shield-check"></i> Yönetim
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-speedometer2"></i>Dashboard
                            </a></li>
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Kullanicilar">
                                <i class="bi bi-people"></i>Kullanıcılar
                            </a></li>
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="BekleyenEgitmenler">
                                <i class="bi bi-hourglass-split"></i>Bekleyen Başvurular
                            </a></li>
                            <li><a class="dropdown-item" asp-controller="Kategori" asp-action="Index">
                                <i class="bi bi-grid"></i>Kategoriler
                            </a></li>
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="TumKurslar">
                                <i class="bi bi-collection-play"></i>Tüm Kurslar
                            </a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="Kurs" asp-action="Olustur">
                                <i class="bi bi-plus-circle"></i>Yeni Kurs Ekle
                            </a></li>
                        </ul>
                    </li>
                }
            </ul>

            <!-- Right side -->
            <ul class="navbar-nav ms-auto align-items-lg-center" style="gap:0.5rem;">
                <!-- Theme Switcher -->
                <li class="nav-item dropdown me-2">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false" style="color:var(--fg-2);">
                        <i class="bi bi-palette"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" style="min-width:180px;">
                        <li><h6 class="dropdown-header">Açık Temalar</h6></li>
                        <li><a class="dropdown-item d-flex align-items-center gap-2 theme-btn" href="#" data-theme-value="light-day">
                            <span style="width:14px;height:14px;border-radius:50%;background:#F59E0B;border:1px solid #ddd;"></span> Günışığı (Day)
                        </a></li>
                        <li><a class="dropdown-item d-flex align-items-center gap-2 theme-btn" href="#" data-theme-value="light-ice">
                            <span style="width:14px;height:14px;border-radius:50%;background:#38BDF8;border:1px solid #ddd;"></span> Buzul (Ice)
                        </a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">Koyu Temalar</h6></li>
                        <li><a class="dropdown-item d-flex align-items-center gap-2 theme-btn" href="#" data-theme-value="midnight">
                            <span style="width:14px;height:14px;border-radius:50%;background:#6366F1;"></span> Gece (Midnight)
                        </a></li>
                        <li><a class="dropdown-item d-flex align-items-center gap-2 theme-btn" href="#" data-theme-value="ocean">
                            <span style="width:14px;height:14px;border-radius:50%;background:#0EA5E9;"></span> Okyanus (Ocean)
                        </a></li>
                        <li><a class="dropdown-item d-flex align-items-center gap-2 theme-btn" href="#" data-theme-value="emerald">
                            <span style="width:14px;height:14px;border-radius:50%;background:#10B981;"></span> Orman (Emerald)
                        </a></li>
                        <li><a class="dropdown-item d-flex align-items-center gap-2 theme-btn" href="#" data-theme-value="royal">
                            <span style="width:14px;height:14px;border-radius:50%;background:#A855F7;"></span> Kraliyet (Royal)
                        </a></li>
                        <li><a class="dropdown-item d-flex align-items-center gap-2 theme-btn" href="#" data-theme-value="cyberpunk">
                            <span style="width:14px;height:14px;border-radius:50%;background:#F43F5E;"></span> Siber (Cyberpunk)
                        </a></li>
                    </ul>
                </li>
                @if (User.Identity!.IsAuthenticated)
                {
                    <li class="nav-item d-none d-lg-flex">
                        <a asp-controller="Ogrenci" asp-action="JetonSatinAl" class="jeton-pill" title="Jeton satin al"><i class="bi bi-coin"></i><strong>@(ViewBag.JetonMiktari ?? 0)</strong> jeton<i class="bi bi-plus-circle"></i></a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 pe-0" href="#" data-bs-toggle="dropdown">
                            <span class="nav-avatar">@(User.Identity.Name?.Substring(0, 1).ToUpper())</span>
                            <span class="d-none d-lg-inline" style="font-size:0.875rem;font-weight:500;color:var(--fg-2);">
                                @(User.Identity.Name?.Split(' ')[0])
                            </span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <div style="padding:0.55rem 0.8rem 0.35rem;font-size:0.72rem;color:var(--fg-3);font-weight:700;text-transform:uppercase;letter-spacing:0.06em;">
                                    @User.Identity.Name
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="Ogrenci" asp-action="Dashboard">
                                <i class="bi bi-collection-play"></i>Kurslarım
                            </a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profil">
                                <i class="bi bi-person"></i>Profilim
                            </a></li>
                            <li><a class="dropdown-item" asp-controller="Ogrenci" asp-action="JetonSatinAl"><i class="bi bi-coin"></i>Jeton Satin Al</a></li>
                            <li class="d-lg-none"><a class="dropdown-item" asp-controller="Ogrenci" asp-action="JetonSatinAl"><i class="bi bi-coin"></i>@(ViewBag.JetonMiktari ?? 0) jeton satin al</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right"></i>Çıkış Yap
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="btn-nav-signin nav-link" asp-controller="Account" asp-action="Login">
                            Giriş Yap
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="btn-nav-cta" asp-controller="Account" asp-action="Register">
                            Ücretsiz Başla
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<!-- ═══ MAIN ════════════════════════════════════ -->
<div class="container main-wrap">

    @if (TempData["Basari"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show au mb-4">
            <i class="bi bi-check-circle-fill"></i>@TempData["Basari"]
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show au mb-4">
            <i class="bi bi-exclamation-triangle-fill"></i>@TempData["Hata"]
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Bilgi"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show au mb-4">
            <i class="bi bi-info-circle-fill"></i>@TempData["Bilgi"]
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <main>@RenderBody()</main>
</div>

<!-- ═══ FOOTER ══════════════════════════════════ -->
<footer class="site-footer">
    <div class="container">
        <div class="row g-5 mb-2">
            <div class="col-lg-4 col-md-6">
                <div class="footer-logo">
                    <span class="footer-logo-icon">
                        <img src="~/eduhub-logo.png" alt="EduHub" />
                    </span>
                    EduHub
                </div>
                <p class="footer-desc">Türkiye'nin en kapsamlı online öğrenim platformu. Uzman eğitmenlerle yeni beceriler kazanın, kariyerinize yön verin.</p>
            </div>
            <div class="col-lg-2 col-md-3 col-6">
                <div class="footer-col-title">Platform</div>
                <ul class="footer-links">
                    <li><a asp-controller="Home" asp-action="Index">Tüm Kurslar</a></li>
                    <li><a asp-controller="Account" asp-action="Register">Kayıt Ol</a></li>
                    <li><a asp-controller="Account" asp-action="Login">Giriş Yap</a></li>
                </ul>
            </div>
            <div class="col-lg-2 col-md-3 col-6">
                <div class="footer-col-title">Eğitmenler</div>
                <ul class="footer-links">
                    <li><a asp-controller="Account" asp-action="Register">Eğitmen Ol</a></li>
                    <li><a asp-controller="Kurs" asp-action="Olustur">Kurs Oluştur</a></li>
                </ul>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="footer-col-title">Platforma Katıl</div>
                <p style="color:var(--fg-3);font-size:0.845rem;margin-bottom:1rem;line-height:1.6;">500 jeton ile başlayın, binlerce kursu keşfedin.</p>
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary">
                    <i class="bi bi-rocket-takeoff me-2"></i>Hemen Başla — Ücretsiz
                </a>
            </div>
        </div>
        <div class="footer-bottom">
            <span>&copy; 2026 EduHub &mdash; Online Kurs Platformu. Tüm hakları saklıdır.</span>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Navbar Scrolled Effect
        const nav = document.getElementById('mainNav');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 20) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        });

        // Theme Switcher Logic
        document.querySelectorAll('.theme-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                const theme = btn.getAttribute('data-theme-value');
                document.documentElement.setAttribute('data-theme', theme);
                localStorage.setItem('eduhub_theme', theme);
            });
        });
        
        // Auto-hide alerts
        document.querySelectorAll('.alert.alert-dismissible').forEach(el => {
            setTimeout(() => bootstrap.Alert.getOrCreateInstance(el)?.close(), 5500);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
