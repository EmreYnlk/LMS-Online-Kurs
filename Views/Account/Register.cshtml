@model LMSPlatform.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-4">
                    <i class="bi bi-person-plus me-2 text-primary"></i>Kayıt Ol
                </h3>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Kayıt Türü</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="card border-2 @(Model?.KayitTuru == "Ogrenci" ? "border-primary" : "") text-center p-3 kayit-kart"
                                     style="cursor:pointer" data-deger="Ogrenci">
                                    <i class="bi bi-mortarboard fs-2 text-primary"></i>
                                    <div class="fw-bold mt-1">Öğrenci</div>
                                    <small class="text-muted">Kurslara katıl</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="card border-2 @(Model?.KayitTuru == "Egitmen" ? "border-success" : "") text-center p-3 kayit-kart"
                                     style="cursor:pointer" data-deger="Egitmen">
                                    <i class="bi bi-easel2 fs-2 text-success"></i>
                                    <div class="fw-bold mt-1">Eğitmen</div>
                                    <small class="text-muted">Kurs oluştur</small>
                                </div>
                            </div>
                        </div>
                        <input asp-for="KayitTuru" type="hidden" id="kayitTuruInput" />
                        <span asp-validation-for="KayitTuru" class="text-danger small"></span>
                    </div>

                    <div id="egitmenBilgi" class="alert alert-warning mb-3" style="display:none">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Eğitmen başvurusu Admin onayına tabidir. Onaylanana kadar öğrenci olarak giriş yapabilirsiniz. Başlangıç olarak 500 jeton verilecektir.
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label asp-for="Ad" class="form-label"></label>
                            <input asp-for="Ad" class="form-control" placeholder="Adınız" />
                            <span asp-validation-for="Ad" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Soyad" class="form-label"></label>
                            <input asp-for="Soyad" class="form-control" placeholder="Soyadınız" />
                            <span asp-validation-for="Soyad" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="ornek@mail.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Sifre" class="form-label"></label>
                        <input asp-for="Sifre" class="form-control" placeholder="En az 6 karakter, 1 rakam içermeli" />
                        <span asp-validation-for="Sifre" class="text-danger small"></span>
                        <small class="text-muted">En az 6 karakter, en az 1 rakam (0-9) içermelidir.</small>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SifreTekrar" class="form-label"></label>
                        <input asp-for="SifreTekrar" class="form-control" placeholder="Şifreyi tekrar girin" />
                        <span asp-validation-for="SifreTekrar" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-2">
                        <i class="bi bi-coin me-2"></i>Kayıt Ol (500 Jeton ile başla!)
                    </button>
                </form>

                <hr />
                <p class="text-center mb-0">
                    Hesabın var mı? <a asp-action="Login">Giriş Yap</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.querySelectorAll('.kayit-kart').forEach(kart => {
            kart.addEventListener('click', function () {
                document.querySelectorAll('.kayit-kart').forEach(k => k.classList.remove('border-primary', 'border-success'));
                const deger = this.dataset.deger;
                document.getElementById('kayitTuruInput').value = deger;
                if (deger === 'Egitmen') {
                    this.classList.add('border-success');
                    document.getElementById('egitmenBilgi').style.display = 'block';
                } else {
                    this.classList.add('border-primary');
                    document.getElementById('egitmenBilgi').style.display = 'none';
                }
            });
        });

        // Sayfa yüklendiğinde varsayılan seçili göster
        const baslangic = document.getElementById('kayitTuruInput').value || 'Ogrenci';
        document.querySelector(`[data-deger="${baslangic}"]`)?.click();
    </script>
}
