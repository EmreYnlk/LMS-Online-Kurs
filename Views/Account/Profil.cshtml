@model LMSPlatform.Models.ApplicationUser
@{
    ViewData["Title"] = "Profilim";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card au" style="border-radius:var(--r-xl) !important;overflow:hidden;">
            <!-- Profile Header -->
            <div class="profile-head">
                <div class="profile-avatar">
                    @(Model.TamAd?.Substring(0, 1).ToUpper() ?? "?")
                </div>
                <h3 style="margin:0;font-size:1.55rem;font-weight:900;letter-spacing:-0.03em;color:var(--fg);">@Model.TamAd</h3>
                <p style="color:var(--fg-3);font-size:0.875rem;margin:0.4rem 0 1.1rem;">@Model.Email</p>
                
                <div style="display:inline-flex;align-items:center;gap:0.45rem;background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.22);color:var(--amber);padding:0.45rem 1.1rem;border-radius:var(--r-full);font-size:0.9rem;font-weight:700;">
                    <i class="bi bi-coin"></i>@Model.JetonMiktari Jeton
                </div>
            </div>

            <!-- Profile Info -->
            <div class="card-body" style="padding:1.75rem 2.25rem;">
                <div style="display:flex;flex-direction:column;gap:0.75rem;">
                    <div class="profile-info-row">
                        <span style="color:var(--fg-3);font-size:0.82rem;display:flex;align-items:center;gap:0.5rem;">
                            <i class="bi bi-calendar3" style="color:var(--indigo-light);"></i>Kayıt Tarihi
                        </span>
                        <strong style="font-size:0.875rem;color:var(--fg);">@Model.KayitTarihi.ToString("dd MMMM yyyy")</strong>
                    </div>

                    @if (Model.EgitmenTalebi)
                    {
                        <div class="profile-info-row">
                            <span style="color:var(--fg-3);font-size:0.82rem;display:flex;align-items:center;gap:0.5rem;">
                                <i class="bi bi-easel2" style="color:var(--indigo-light);"></i>Eğitmen Durumu
                            </span>
                            @if (Model.EgitmenOnaylandi)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Onaylı Eğitmen</span>
                            }
                            else
                            {
                                <span class="badge bg-warning"><i class="bi bi-hourglass me-1"></i>Onay Bekliyor</span>
                            }
                        </div>
                    }

                    <div class="profile-info-row">
                        <span style="color:var(--fg-3);font-size:0.82rem;display:flex;align-items:center;gap:0.5rem;">
                            <i class="bi bi-coin" style="color:var(--amber);"></i>Jeton Bakiyesi
                        </span>
                        <strong style="font-size:0.875rem;color:var(--amber);">@Model.JetonMiktari jeton</strong>
                    </div>
                </div>

                <div style="margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid var(--border);">
                    <a asp-controller="Ogrenci" asp-action="Dashboard" class="btn btn-primary w-100 btn-lg" style="border-radius:var(--r-md) !important;">
                        <i class="bi bi-collection-play me-2"></i>Kurslarıma Git
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
