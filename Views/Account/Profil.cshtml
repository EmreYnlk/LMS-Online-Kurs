@model LMSPlatform.Models.ApplicationUser
@{
    ViewData["Title"] = "Profilim";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body p-4 text-center">
                <i class="bi bi-person-circle text-primary" style="font-size:5rem"></i>
                <h3 class="mt-2">@Model.TamAd</h3>
                <p class="text-muted">@Model.Email</p>
                <div class="badge bg-warning text-dark fs-5 mb-3">
                    <i class="bi bi-coin me-1"></i>@Model.JetonMiktari Jeton
                </div>
                <hr />
                <div class="row text-start">
                    <div class="col-6"><strong>Kayıt Tarihi:</strong></div>
                    <div class="col-6">@Model.KayitTarihi.ToString("dd.MM.yyyy")</div>
                    @if (Model.EgitmenTalebi)
                    {
                        <div class="col-6 mt-2"><strong>Eğitmen Durumu:</strong></div>
                        <div class="col-6 mt-2">
                            @if (Model.EgitmenOnaylandi)
                            {
                                <span class="badge bg-success">Onaylı Eğitmen</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Onay Bekliyor</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
