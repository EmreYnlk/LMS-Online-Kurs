@model IEnumerable<LMSPlatform.Models.ApplicationUser>
@{
    ViewData["Title"] = "Bekleyen Eğitmen Başvuruları";
}

<div class="page-header animate-fade-up">
    <div class="page-header-left">
        <h2><i class="bi bi-person-check me-2" style="color:var(--secondary);font-size:1.5rem;"></i>Bekleyen Başvurular</h2>
        <p>Eğitmen olmak isteyen kullanıcıları onaylayın</p>
    </div>
    @if (Model.Any())
    {
        <span style="background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.25);color:var(--secondary);padding:0.4rem 1rem;border-radius:var(--radius-full);font-size:0.8rem;font-weight:700;">
            <i class="bi bi-hourglass-split me-1"></i>@Model.Count() Bekleyen
        </span>
    }
</div>

@if (!Model.Any())
{
    <div class="card animate-fade-up">
        <div class="card-body text-center py-5">
            <div style="width:72px;height:72px;border-radius:50%;background:rgba(16,185,129,0.1);display:flex;align-items:center;justify-content:center;margin:0 auto 1.25rem;">
                <i class="bi bi-check-circle-fill" style="font-size:2rem;color:#34D399;"></i>
            </div>
            <h5 style="color:var(--text-secondary);">Bekleyen başvuru yok</h5>
            <p style="color:var(--text-muted);font-size:0.875rem;margin:0;">Tüm başvurular işlenmiş.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3 animate-fade-up-delay-1">
        @foreach (var user in Model)
        {
            <div class="col-md-6">
                <div class="card" style="border-color:rgba(245,158,11,0.2) !important;">
                    <div class="card-body" style="padding:1.5rem;">
                        <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.25rem;">
                            <div style="width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,var(--secondary),var(--secondary-dark));display:flex;align-items:center;justify-content:center;font-size:1.25rem;font-weight:800;color:white;flex-shrink:0;">
                                @(user.TamAd?.Substring(0, 1).ToUpper() ?? "?")
                            </div>
                            <div>
                                <h5 style="margin:0;font-weight:700;font-size:1rem;">@user.TamAd</h5>
                                <p style="margin:0.15rem 0 0;color:var(--text-muted);font-size:0.825rem;">@user.Email</p>
                                <span style="font-size:0.75rem;color:var(--text-muted);">
                                    <i class="bi bi-calendar3 me-1"></i>Kayıt: @user.KayitTarihi.ToString("dd.MM.yyyy")
                                </span>
                            </div>
                            <span class="badge bg-warning ms-auto">
                                <i class="bi bi-hourglass me-1"></i>Bekliyor
                            </span>
                        </div>
                        <div style="display:flex;gap:0.75rem;">
                            <form asp-action="EgitmenOnayla" method="post" style="flex:1;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="bi bi-check-circle me-2"></i>Onayla
                                </button>
                            </form>
                            <form asp-action="EgitmenReddet" method="post" style="flex:1;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="btn btn-outline-danger w-100"
                                        onclick="return confirm('Bu başvuruyu reddetmek istediğinizden emin misiniz?')">
                                    <i class="bi bi-x-circle me-2"></i>Reddet
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
