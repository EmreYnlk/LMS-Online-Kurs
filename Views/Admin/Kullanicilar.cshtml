@model IEnumerable<LMSPlatform.ViewModels.KullaniciListeViewModel>
@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="page-header animate-fade-up">
    <div class="page-header-left">
        <h2><i class="bi bi-people me-2" style="color:var(--primary-light);font-size:1.5rem;"></i>Kullanıcılar</h2>
        <p>Tüm platform kullanıcılarını yönetin</p>
    </div>
    <span style="background:rgba(108,99,255,0.1);border:1px solid rgba(108,99,255,0.2);color:var(--primary-light);padding:0.4rem 1rem;border-radius:var(--radius-full);font-size:0.8rem;font-weight:600;">
        @Model.Count() kullanıcı
    </span>
</div>

<div class="card animate-fade-up" style="overflow:hidden;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Kullanıcı</th>
                    <th>E-posta</th>
                    <th>Roller</th>
                    <th>Jeton</th>
                    <th>Eğitmen Durumu</th>
                    <th style="text-align:right;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var isAdmin = item.Roller.Contains("Admin");
                    var isEgitmen = item.Roller.Contains("Egitmen");
                    <tr>
                        <td>
                            <div style="display:flex;align-items:center;gap:0.75rem;">
                                <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--primary-dark));display:flex;align-items:center;justify-content:center;font-size:0.875rem;font-weight:700;color:white;flex-shrink:0;">
                                    @(item.Kullanici.TamAd?.Substring(0, 1).ToUpper() ?? "?")
                                </div>
                                <strong style="color:var(--text-primary);font-size:0.875rem;">@item.Kullanici.TamAd</strong>
                            </div>
                        </td>
                        <td style="color:var(--text-muted);font-size:0.85rem;">@item.Kullanici.Email</td>
                        <td>
                            @foreach (var rol in item.Roller)
                            {
                                <span class="badge @(rol == "Admin" ? "bg-danger" : rol == "Egitmen" ? "bg-success" : "bg-secondary") me-1">@rol</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-warning">
                                <i class="bi bi-coin me-1"></i>@item.Kullanici.JetonMiktari
                            </span>
                        </td>
                        <td>
                            @if (item.Kullanici.EgitmenTalebi)
                            {
                                @if (item.Kullanici.EgitmenOnaylandi)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Onaylı</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning"><i class="bi bi-hourglass me-1"></i>Bekliyor</span>
                                }
                            }
                            else
                            {
                                <span style="color:var(--text-muted);font-size:0.8rem;">—</span>
                            }
                        </td>
                        <td style="text-align:right;">
                            <div style="display:flex;gap:0.4rem;justify-content:flex-end;flex-wrap:wrap;">
                                <!-- Jeton Ekle -->
                                <a asp-action="JetonEkle" asp-route-userId="@item.Kullanici.Id"
                                   class="btn btn-sm btn-outline-warning" title="Jeton Ekle">
                                    <i class="bi bi-coin"></i>
                                </a>

                                @if (!isAdmin)
                                {
                                    <!-- Eğitmen rol ekle/kaldır -->
                                    @if (isEgitmen)
                                    {
                                        <form asp-action="EgitmenRolKaldir" asp-route-userId="@item.Kullanici.Id" method="post" style="display:inline;"
                                              onsubmit="return confirm('@item.Kullanici.TamAd kullanıcısının eğitmen yetkisi kaldırılsın mı?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Eğitmen Yetkisini Kaldır">
                                                <i class="bi bi-person-dash"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="EgitmenRolEkle" asp-route-userId="@item.Kullanici.Id" method="post" style="display:inline;"
                                              onsubmit="return confirm('@item.Kullanici.TamAd kullanıcısına eğitmen yetkisi verilsin mi?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Eğitmen Yetkisi Ver">
                                                <i class="bi bi-person-plus"></i>
                                            </button>
                                        </form>
                                    }

                                    <!-- Kullanıcı sil -->
                                    <form asp-action="KullaniciSil" asp-route-userId="@item.Kullanici.Id" method="post" style="display:inline;"
                                          onsubmit="return confirm('@item.Kullanici.TamAd kullanıcısı kalıcı olarak silinsin mi? Bu işlem geri alınamaz!')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Kullanıcıyı Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3" style="font-size:0.78rem;color:var(--fg-3);">
    <i class="bi bi-info-circle me-1"></i>
    <i class="bi bi-coin" style="color:var(--amber);"></i> Jeton Ekle &nbsp;|&nbsp;
    <i class="bi bi-person-plus" style="color:var(--emerald);"></i> Eğitmen Yetkisi Ver &nbsp;|&nbsp;
    <i class="bi bi-person-dash" style="color:var(--fg-2);"></i> Eğitmen Yetkisini Kaldır &nbsp;|&nbsp;
    <i class="bi bi-trash" style="color:var(--rose);"></i> Kullanıcıyı Sil
</div>
