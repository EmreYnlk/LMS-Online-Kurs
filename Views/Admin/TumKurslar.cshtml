@model IEnumerable<LMSPlatform.Models.Kurs>
@{
    ViewData["Title"] = "Tüm Kurslar";
}

<div class="page-header animate-fade-up">
    <div class="page-header-left">
        <h2><i class="bi bi-collection-play me-2" style="color:var(--primary-light);font-size:1.5rem;"></i>Tüm Kurslar</h2>
        <p>Platformdaki tüm kursları görüntüleyin</p>
    </div>
    <span style="background:rgba(108,99,255,0.1);border:1px solid rgba(108,99,255,0.2);color:var(--primary-light);padding:0.4rem 1rem;border-radius:var(--radius-full);font-size:0.8rem;font-weight:600;">
        @Model.Count() kurs
    </span>
</div>

<div class="card animate-fade-up" style="overflow:hidden;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Kurs</th>
                    <th>Kategori</th>
                    <th>Eğitmen</th>
                    <th>Fiyat</th>
                    <th>Abone</th>
                    <th>Tarih</th>
                    <th style="text-align:right;">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kurs in Model)
                {
                    <tr>
                        <td>
                            <div style="display:flex;align-items:center;gap:0.75rem;">
                                <div style="width:38px;height:38px;border-radius:var(--radius-sm);background:rgba(108,99,255,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                    <i class="bi bi-play-circle-fill" style="color:var(--primary-light);font-size:1rem;"></i>
                                </div>
                                <strong style="color:var(--text-primary);font-size:0.875rem;">@kurs.Baslik</strong>
                            </div>
                        </td>
                        <td><span class="badge bg-secondary">@kurs.Kategori?.Ad</span></td>
                        <td style="color:var(--text-secondary);font-size:0.85rem;">@kurs.Egitmen?.TamAd</td>
                        <td>
                            @if (kurs.Ucretsiz)
                            {
                                <span class="badge bg-success"><i class="bi bi-gift me-1"></i>Ücretsiz</span>
                            }
                            else
                            {
                                <span class="badge bg-warning"><i class="bi bi-coin me-1"></i>@kurs.Fiyat</span>
                            }
                        </td>
                        <td style="color:var(--text-secondary);font-size:0.85rem;">
                            <i class="bi bi-people me-1" style="color:var(--primary-light);"></i>@kurs.AbonelikSayisi
                        </td>
                        <td style="color:var(--text-muted);font-size:0.8rem;">@kurs.OlusturmaTarihi.ToString("dd.MM.yyyy")</td>
                        <td style="text-align:right;">
                            <a asp-controller="Kurs" asp-action="Detay" asp-route-id="@kurs.Id"
                               class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye me-1"></i>Detay
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
