@model IEnumerable<LMSPlatform.Models.Kurs>
@{
    ViewData["Title"] = "Tüm Kurslar";
}
<h2 class="mb-4"><i class="bi bi-collection-play me-2"></i>Tüm Kurslar</h2>
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Başlık</th>
                <th>Kategori</th>
                <th>Eğitmen</th>
                <th>Fiyat</th>
                <th>Abone</th>
                <th>Tarih</th>
                <th>İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var kurs in Model)
            {
                <tr>
                    <td><strong>@kurs.Baslik</strong></td>
                    <td><span class="badge bg-secondary">@kurs.Kategori?.Ad</span></td>
                    <td>@kurs.Egitmen?.TamAd</td>
                    <td>@(kurs.Ucretsiz ? "Ücretsiz" : $"{kurs.Fiyat} jeton")</td>
                    <td>@kurs.AbonelikSayisi</td>
                    <td>@kurs.OlusturmaTarihi.ToString("dd.MM.yyyy")</td>
                    <td>
                        <a asp-controller="Kurs" asp-action="Detay" asp-route-id="@kurs.Id"
                           class="btn btn-sm btn-outline-info">Detay</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
