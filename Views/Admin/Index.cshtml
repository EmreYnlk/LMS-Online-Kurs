@model LMSPlatform.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Page Header -->
<div class="page-hdr au">
    <div>
        <h2>
            <span class="hdr-icon" style="background:rgba(99,102,241,0.10);color:var(--indigo-light);">
                <i class="bi bi-speedometer2"></i>
            </span>
            Admin Dashboard
        </h2>
        <div class="sub"><i class="bi bi-circle-fill me-1" style="font-size:0.45rem;color:#34D399;"></i>Sistem aktif &mdash; @DateTime.Now.ToString("dd MMM yyyy, HH:mm")</div>
    </div>
    <div style="display:flex;gap:0.6rem;flex-wrap:wrap;">
        <a asp-action="BekleyenEgitmenler" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-hourglass-split me-1"></i>Bekleyenler
            @if (Model.BekleyenEgitmen > 0)
            {
                <span class="badge bg-warning ms-1">@Model.BekleyenEgitmen</span>
            }
        </a>
        <a asp-controller="Kurs" asp-action="Olustur" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i>Yeni Kurs
        </a>
    </div>
</div>

<!-- ── Stats Row ── -->
<div class="row g-3 mb-4 au-1">
    <div class="col-md-3 col-sm-6">
        <div class="card stat-card indigo">
            <div class="card-body" style="padding:1.4rem;">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1rem;">
                    <div>
                        <div style="font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.07em;color:rgba(255,255,255,0.65);margin-bottom:0.5rem;">Kullanıcılar</div>
                        <div style="font-size:2.6rem;font-weight:900;color:white;line-height:1;letter-spacing:-0.04em;">@Model.ToplamKullanici</div>
                    </div>
                    <div style="width:44px;height:44px;border-radius:12px;background:rgba(255,255,255,0.15);display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:white;flex-shrink:0;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <a asp-action="Kullanicilar">Tümünü Gör <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card stat-card emerald">
            <div class="card-body" style="padding:1.4rem;">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1rem;">
                    <div>
                        <div style="font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.07em;color:rgba(255,255,255,0.65);margin-bottom:0.5rem;">Kurslar</div>
                        <div style="font-size:2.6rem;font-weight:900;color:white;line-height:1;letter-spacing:-0.04em;">@Model.ToplamKurs</div>
                    </div>
                    <div style="width:44px;height:44px;border-radius:12px;background:rgba(255,255,255,0.15);display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:white;flex-shrink:0;">
                        <i class="bi bi-collection-play-fill"></i>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <a asp-action="TumKurslar">Tümünü Gör <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card stat-card amber">
            <div class="card-body" style="padding:1.4rem;">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1rem;">
                    <div>
                        <div style="font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.07em;color:rgba(255,255,255,0.65);margin-bottom:0.5rem;">Bekleyen</div>
                        <div style="font-size:2.6rem;font-weight:900;color:white;line-height:1;letter-spacing:-0.04em;">@Model.BekleyenEgitmen</div>
                    </div>
                    <div style="width:44px;height:44px;border-radius:12px;background:rgba(255,255,255,0.15);display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:white;flex-shrink:0;">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <a asp-action="BekleyenEgitmenler">İncele <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card stat-card sky">
            <div class="card-body" style="padding:1.4rem;">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1rem;">
                    <div>
                        <div style="font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:0.07em;color:rgba(255,255,255,0.65);margin-bottom:0.5rem;">Abonelikler</div>
                        <div style="font-size:2.6rem;font-weight:900;color:white;line-height:1;letter-spacing:-0.04em;">@Model.ToplamAbonelik</div>
                    </div>
                    <div style="width:44px;height:44px;border-radius:12px;background:rgba(255,255,255,0.15);display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:white;flex-shrink:0;">
                        <i class="bi bi-cart-check-fill"></i>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <span style="color:rgba(255,255,255,0.6);">Toplam satış</span>
            </div>
        </div>
    </div>
</div>

<!-- ── Quick Actions ── -->
<div class="au-2">
    <div style="font-size:0.72rem;font-weight:800;text-transform:uppercase;letter-spacing:0.07em;color:var(--fg-3);margin-bottom:1rem;">
        <i class="bi bi-lightning-charge me-1" style="color:var(--amber);"></i>Hızlı İşlemler
    </div>
    <div class="row g-3">
        <div class="col-md-4 col-sm-6">
            <a asp-action="BekleyenEgitmenler" class="qa-card">
                <div class="qa-icon amber"><i class="bi bi-person-check-fill"></i></div>
                <div>
                    <div class="qa-card-title">Eğitmen Onayları</div>
                    <div class="qa-card-sub">
                        @Model.BekleyenEgitmen bekleyen başvuru
                        @if (Model.BekleyenEgitmen > 0)
                        {
                            <span class="badge bg-warning ms-1">!</span>
                        }
                    </div>
                </div>
                <i class="bi bi-chevron-right ms-auto" style="color:var(--fg-3);font-size:0.8rem;"></i>
            </a>
        </div>
        <div class="col-md-4 col-sm-6">
            <a asp-controller="Kategori" asp-action="Index" class="qa-card">
                <div class="qa-icon sky"><i class="bi bi-grid-fill"></i></div>
                <div>
                    <div class="qa-card-title">Kategori Yönetimi</div>
                    <div class="qa-card-sub">Ekle, düzenle, sil</div>
                </div>
                <i class="bi bi-chevron-right ms-auto" style="color:var(--fg-3);font-size:0.8rem;"></i>
            </a>
        </div>
        <div class="col-md-4 col-sm-6">
            <a asp-action="Kullanicilar" class="qa-card">
                <div class="qa-icon emerald"><i class="bi bi-coin"></i></div>
                <div>
                    <div class="qa-card-title">Jeton Yönetimi</div>
                    <div class="qa-card-sub">Kullanıcılara jeton ekle</div>
                </div>
                <i class="bi bi-chevron-right ms-auto" style="color:var(--fg-3);font-size:0.8rem;"></i>
            </a>
        </div>
        <div class="col-md-4 col-sm-6">
            <a asp-action="TumKurslar" class="qa-card">
                <div class="qa-icon indigo"><i class="bi bi-collection-play-fill"></i></div>
                <div>
                    <div class="qa-card-title">Tüm Kurslar</div>
                    <div class="qa-card-sub">@Model.ToplamKurs aktif kurs</div>
                </div>
                <i class="bi bi-chevron-right ms-auto" style="color:var(--fg-3);font-size:0.8rem;"></i>
            </a>
        </div>
        <div class="col-md-4 col-sm-6">
            <a asp-controller="Kurs" asp-action="Olustur" class="qa-card">
                <div class="qa-icon rose"><i class="bi bi-plus-circle-fill"></i></div>
                <div>
                    <div class="qa-card-title">Yeni Kurs Ekle</div>
                    <div class="qa-card-sub">Hemen oluşturmaya başla</div>
                </div>
                <i class="bi bi-chevron-right ms-auto" style="color:var(--fg-3);font-size:0.8rem;"></i>
            </a>
        </div>
        <div class="col-md-4 col-sm-6">
            <a asp-controller="Home" asp-action="Index" class="qa-card">
                <div class="qa-icon amber"><i class="bi bi-house-fill"></i></div>
                <div>
                    <div class="qa-card-title">Ana Sayfaya Git</div>
                    <div class="qa-card-sub">Siteyi ziyaretçi gözüyle gör</div>
                </div>
                <i class="bi bi-chevron-right ms-auto" style="color:var(--fg-3);font-size:0.8rem;"></i>
            </a>
        </div>
    </div>
</div>
