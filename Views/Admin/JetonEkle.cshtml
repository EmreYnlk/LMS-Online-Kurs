@model LMSPlatform.ViewModels.JetonEkleViewModel
@{
    ViewData["Title"] = "Jeton Ekle";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-warning">
                <h4 class="mb-0"><i class="bi bi-coin me-2"></i>Jeton Ekle</h4>
            </div>
            <div class="card-body">
                <p><strong>Kullanıcı:</strong> @Model.KullaniciAdi</p>
                <p><strong>Mevcut Jeton:</strong>
                    <span class="badge bg-warning text-dark fs-6">@Model.MevcutJeton</span>
                </p>

                <form asp-action="JetonEkle" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="KullaniciId" />
                    <input type="hidden" asp-for="KullaniciAdi" />
                    <input type="hidden" asp-for="MevcutJeton" />

                    <div class="mb-4">
                        <label asp-for="EklenecekJeton" class="form-label fw-bold"></label>
                        <input asp-for="EklenecekJeton" class="form-control form-control-lg" type="number" min="1" max="10000" placeholder="100" />
                        <span asp-validation-for="EklenecekJeton" class="text-danger small"></span>
                        <small class="text-muted d-block mt-1">Yeni toplam: @Model.MevcutJeton + <span id="eklenecek">0</span> = <span id="toplam">@Model.MevcutJeton</span></small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-plus-circle me-1"></i>Jeton Ekle
                        </button>
                        <a asp-action="Kullanicilar" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const input = document.querySelector('[name="EklenecekJeton"]');
        input.addEventListener('input', function () {
            const val = parseInt(this.value) || 0;
            document.getElementById('eklenecek').textContent = val;
            document.getElementById('toplam').textContent = @Model.MevcutJeton + val;
        });
    </script>
}
