@model LMSPlatform.ViewModels.AnaSayfaViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="bg-primary text-white rounded-3 p-5 mb-4">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1 class="display-5 fw-bold">EduHub'a Hoş Geldiniz!</h1>
            <p class="lead">Binlerce kursa erişin, yeni beceriler kazanın.</p>
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input type="text" name="ara" value="@Model.AramaMetni"
                       class="form-control" placeholder="Kurs ara..." />
                <button type="submit" class="btn btn-warning px-4">
                    <i class="bi bi-search"></i>
                </button>
            </form>
        </div>
        <div class="col-md-4 text-center d-none d-md-block">
            <i class="bi bi-mortarboard-fill" style="font-size:8rem; opacity:0.3"></i>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3">
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-grid me-2"></i>Kategoriler
            </div>
            <div class="list-group list-group-flush">
                <a asp-action="Index" class="list-group-item list-group-item-action @(Model.SeciliKategoriId == null ? "active" : "")">
                    Tümü
                </a>
                @foreach (var kat in Model.Kategoriler)
                {
                    <a asp-action="Index" asp-route-kategoriId="@kat.Id"
                       class="list-group-item list-group-item-action @(Model.SeciliKategoriId == kat.Id ? "active" : "")">
                        @kat.Ad
                    </a>
                }
            </div>
        </div>

        @await Component.InvokeAsync("PopulerKurslar", new { adet = 5 })
    </div>

    <div class="col-md-9">
        @if (!string.IsNullOrEmpty(Model.AramaMetni))
        {
            <div class="alert alert-info">
                "<strong>@Model.AramaMetni</strong>" için @Model.Kurslar.Count sonuç bulundu.
                <a asp-action="Index" class="ms-2">Temizle</a>
            </div>
        }

        @if (!Model.Kurslar.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox text-muted" style="font-size:4rem"></i>
                <h4 class="mt-3 text-muted">Henüz kurs bulunmuyor.</h4>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var kurs in Model.Kurslar)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm hover-shadow">
                            @if (!string.IsNullOrEmpty(kurs.ResimUrl))
                            {
                                <img src="@kurs.ResimUrl" class="card-img-top" style="height:150px;object-fit:cover" alt="@kurs.Baslik" />
                            }
                            else
                            {
                                <div class="bg-gradient bg-primary d-flex align-items-center justify-content-center" style="height:150px">
                                    <i class="bi bi-play-circle text-white" style="font-size:3rem;opacity:0.7"></i>
                                </div>
                            }
                            <div class="card-body d-flex flex-column">
                                <span class="badge bg-secondary mb-1 align-self-start">@kurs.Kategori?.Ad</span>
                                <h6 class="card-title">@kurs.Baslik</h6>
                                <p class="card-text text-muted small flex-grow-1">
                                    @(kurs.Aciklama.Length > 80 ? kurs.Aciklama[..80] + "..." : kurs.Aciklama)
                                </p>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <small class="text-muted">
                                        <i class="bi bi-people me-1"></i>@kurs.AbonelikSayisi abone
                                    </small>
                                    @if (kurs.Ucretsiz)
                                    {
                                        <span class="badge bg-success">Ücretsiz</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-coin me-1"></i>@kurs.Fiyat
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="card-footer bg-transparent">
                                <a asp-controller="Kurs" asp-action="Detay" asp-route-id="@kurs.Id"
                                   class="btn btn-outline-primary btn-sm w-100">
                                    <i class="bi bi-eye me-1"></i>Kursu İncele
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
