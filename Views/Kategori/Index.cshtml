@model IEnumerable<LMSPlatform.Models.Kategori>
@{
    ViewData["Title"] = "Kategoriler";
}

<div class="page-header animate-fade-up">
    <div class="page-header-left">
        <h2><i class="bi bi-grid me-2" style="color:var(--primary-light);font-size:1.5rem;"></i>Kategoriler</h2>
        <p>Platform kategorilerini yönetin</p>
    </div>
    <a asp-action="Olustur" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Yeni Kategori
    </a>
</div>

<div class="card animate-fade-up" style="overflow:hidden;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Kategori</th>
                    <th>Açıklama</th>
                    <th>Kurslar</th>
                    <th style="text-align:right;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kat in Model)
                {
                    <tr>
                        <td>
                            <div style="display:flex;align-items:center;gap:0.75rem;">
                                <div style="width:36px;height:36px;border-radius:var(--radius-sm);background:rgba(108,99,255,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                    <i class="bi bi-tag-fill" style="color:var(--primary-light);font-size:0.9rem;"></i>
                                </div>
                                <strong style="color:var(--text-primary);font-size:0.9rem;">@kat.Ad</strong>
                            </div>
                        </td>
                        <td style="color:var(--text-muted);font-size:0.85rem;">@(kat.Aciklama ?? "—")</td>
                        <td>
                            <span class="badge bg-primary">
                                <i class="bi bi-collection-play me-1"></i>@kat.Kurslar.Count kurs
                            </span>
                        </td>
                        <td style="text-align:right;">
                            <div style="display:flex;gap:0.5rem;justify-content:flex-end;">
                                <a asp-action="Duzenle" asp-route-id="@kat.Id" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil me-1"></i>Düzenle
                                </a>
                                <form asp-action="Sil" asp-route-id="@kat.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Bu kategoriyi silmek istediğinizden emin misiniz?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
