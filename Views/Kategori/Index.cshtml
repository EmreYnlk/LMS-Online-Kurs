@model IEnumerable<LMSPlatform.Models.Kategori>
@{
    ViewData["Title"] = "Kategoriler";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-grid me-2"></i>Kategoriler</h2>
    <a asp-action="Olustur" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Yeni Kategori
    </a>
</div>
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Kategori Adı</th>
                <th>Açıklama</th>
                <th>Kurs Sayısı</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var kat in Model)
            {
                <tr>
                    <td><strong>@kat.Ad</strong></td>
                    <td class="text-muted">@(kat.Aciklama ?? "-")</td>
                    <td><span class="badge bg-primary">@kat.Kurslar.Count kurs</span></td>
                    <td>
                        <a asp-action="Duzenle" asp-route-id="@kat.Id" class="btn btn-sm btn-outline-warning">Düzenle</a>
                        <form asp-action="Sil" asp-route-id="@kat.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Bu kategoriyi silmek istediğinizden emin misiniz?')">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
