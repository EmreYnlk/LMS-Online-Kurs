@model IEnumerable<LMSPlatform.Models.KursAbonelik>
@{
    ViewData["Title"] = "Kurslarım";
    var ilerlemeler = ViewBag.Ilerlemeler as List<LMSPlatform.Models.DersIlerleme> ?? new();
    var kullanici = ViewBag.Kullanici as LMSPlatform.Models.ApplicationUser;
}

<div class="page-hdr au">
    <div>
        <h2>
            <span class="hdr-icon" style="background:rgba(99,102,241,0.10);color:var(--indigo-light);">
                <i class="bi bi-collection-play"></i>
            </span>
            Kurslarım
        </h2>
        <div class="sub">Kayıtlı olduğunuz kursları takip edin ve öğrenmeye devam edin</div>
    </div>
    <div style="display:inline-flex;align-items:center;gap:0.5rem;background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.25);color:var(--amber);padding:0.4rem 1.1rem;border-radius:var(--r-full);font-size:0.9rem;font-weight:700;">
        <i class="bi bi-coin"></i>@kullanici?.JetonMiktari Jeton
    </div>
</div>

@if (!Model.Any())
{
    <div class="card au">
        <div class="card-body text-center py-5">
            <div style="width:88px;height:88px;border-radius:50%;background:rgba(99,102,241,0.08);display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem;">
                <i class="bi bi-mortarboard" style="font-size:2.75rem;color:var(--indigo-light);opacity:0.4;"></i>
            </div>
            <h5 style="color:var(--fg-2);">Henüz bir kursa kaydolmadınız</h5>
            <p style="color:var(--fg-3);font-size:0.875rem;margin-bottom:1.5rem;">İlginizi çeken bir kursu bulun ve öğrenmeye başlayın!</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary" style="border-radius:var(--r-full) !important;padding:10px 24px;">
                <i class="bi bi-search me-2"></i>Kurslara Göz At
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4 au-1">
        @foreach (var abonelik in Model)
        {
            var kurs = abonelik.Kurs!;
            var kursDersIds = kurs.Dersler.Select(d => d.Id).ToList();
            var tamamlanan = ilerlemeler.Count(i => kursDersIds.Contains(i.DersId) && i.Tamamlandi);
            var toplam = kurs.Dersler.Count;
            var yuzde = toplam > 0 ? (tamamlanan * 100 / toplam) : 0;

            <div class="col-md-6 col-xl-4">
                <div class="card course-card h-100" style="border-radius:var(--r-xl) !important;">
                    <!-- Progress top bar -->
                    <div style="height:3px;background:rgba(255,255,255,0.06);">
                        <div style="height:100%;width:@yuzde%;background:linear-gradient(90deg,var(--indigo),var(--emerald));transition:width 1s ease;"></div>
                    </div>

                    <div class="card-body d-flex flex-column" style="padding:1.4rem;">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="badge bg-secondary">@kurs.Kategori?.Ad</span>
                            @if (yuzde == 100)
                            {
                                <span class="badge bg-success"><i class="bi bi-trophy me-1"></i>Tamamlandı</span>
                            }
                            else if (yuzde > 0)
                            {
                                <span class="badge bg-primary">Devam Ediyor</span>
                            }
                            else
                            {
                                <span class="badge bg-dark">Başlanmadı</span>
                            }
                        </div>

                        <h5 class="card-title" style="font-size:1.05rem;line-height:1.4;margin-bottom:0.75rem;font-weight:800;letter-spacing:-0.02em;">@kurs.Baslik</h5>
                        <p style="font-size:0.8rem;color:var(--fg-3);margin-bottom:1.25rem;display:flex;align-items:center;gap:0.4rem;">
                            <div style="width:20px;height:20px;border-radius:50%;background:linear-gradient(135deg,var(--indigo),#7C3AED);display:flex;align-items:center;justify-content:center;font-size:0.55rem;font-weight:800;color:white;flex-shrink:0;">
                                @(kurs.Egitmen?.TamAd?.Substring(0,1).ToUpper() ?? "E")
                            </div>
                            @kurs.Egitmen?.TamAd
                        </p>

                        <!-- Progress Section -->
                        <div style="margin-bottom:1.25rem;">
                            <div style="display:flex;justify-content:space-between;font-size:0.78rem;color:var(--fg-3);margin-bottom:0.4rem;">
                                <span>İlerleme</span>
                                <span><strong style="color:var(--fg-2);">@tamamlanan</strong> / @toplam ders — <strong style="color:var(--indigo-light);">%@yuzde</strong></span>
                            </div>
                            <div class="progress" style="height:6px !important;border-radius:10px !important;">
                                <div class="progress-bar" style="width:@yuzde%;background:@(yuzde == 100 ? "linear-gradient(90deg,var(--emerald),#34D399)" : "linear-gradient(90deg,var(--indigo),var(--indigo-light))")"></div>
                            </div>
                        </div>

                        <p style="font-size:0.75rem;color:var(--fg-3);margin-bottom:1.25rem;display:flex;align-items:center;gap:0.35rem;">
                            <i class="bi bi-calendar3"></i>@abonelik.AbonelikTarihi.ToString("dd.MM.yyyy") tarihinde kaydoldunuz
                        </p>

                        <div class="mt-auto">
                            @if (kurs.Dersler.Any())
                            {
                                var ilkDers = kurs.Dersler.OrderBy(d => d.Sira).First();
                                <a asp-controller="Ogrenci" asp-action="DersIzle" asp-route-dersId="@ilkDers.Id"
                                   class="btn @(yuzde > 0 ? "btn-primary" : "btn-outline-primary") w-100" style="border-radius:var(--r-md) !important;">
                                    <i class="bi bi-@(yuzde > 0 ? "play-fill" : "play-circle") me-2"></i>
                                    @(yuzde == 100 ? "Tekrar İzle" : yuzde > 0 ? "Devam Et" : "Derse Başla")
                                </a>
                            }
                            else
                            {
                                <div style="text-align:center;color:var(--fg-3);font-size:0.8rem;padding:0.75rem;background:rgba(255,255,255,0.03);border-radius:var(--r-sm);border:1px dashed var(--border);">
                                    <i class="bi bi-hourglass me-1"></i>Dersler yakında eklenecek
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
