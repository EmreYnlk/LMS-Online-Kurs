@model LMSPlatform.ViewModels.JetonSatinAlViewModel
@{
    ViewData["Title"] = "Jeton Satın Al";
    var paketler = ViewBag.Paketler as List<LMSPlatform.ViewModels.JetonPaketi> ?? new();
    var seciliPaket = paketler.FirstOrDefault(p => p.Id == Model.PaketId);
}

<h2 class="mb-4"><i class="bi bi-coin me-2 text-warning"></i>Jeton Satın Al</h2>

<div class="row g-4 mb-5">
    @foreach (var paket in paketler)
    {
        var birimFiyat = paket.Fiyat / paket.Jeton;
        <div class="col-md-4">
            <div class="card h-100 shadow @(paket.PopulerMi ? "border-primary border-2" : "") @(Model.PaketId == paket.Id ? "border-success border-3" : "")"
                 style="cursor:pointer" onclick="paketSec(@paket.Id, '@paket.Ad', @paket.Jeton, '@paket.Fiyat.ToString("F2")')">
                @if (paket.Etiket != null)
                {
                    <div class="card-header @(paket.PopulerMi ? "bg-primary text-white" : "bg-success text-white") text-center fw-bold">
                        @paket.Etiket
                    </div>
                }
                <div class="card-body text-center">
                    <h4 class="card-title">@paket.Ad</h4>
                    <div class="display-5 fw-bold text-warning my-3">
                        <i class="bi bi-coin me-1"></i>@paket.Jeton
                    </div>
                    <div class="fs-4 fw-bold text-dark">@paket.Fiyat.ToString("F2") ₺</div>
                    <small class="text-muted">(@birimFiyat.ToString("F3") ₺ / jeton)</small>
                </div>
                <div class="card-footer text-center">
                    @if (Model.PaketId == paket.Id)
                    {
                        <span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>Seçildi</span>
                    }
                    else
                    {
                        <span class="text-primary">Seç →</span>
                    }
                </div>
            </div>
        </div>
    }
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="bi bi-credit-card me-2"></i>Ödeme Bilgileri</h5>
            </div>
            <div class="card-body">
                @if (seciliPaket != null)
                {
                    <div class="alert alert-success mb-3">
                        <strong>Seçilen Paket:</strong> @seciliPaket.Ad —
                        <span class="text-warning fw-bold"><i class="bi bi-coin me-1"></i>@seciliPaket.Jeton jeton</span>
                        için <strong>@seciliPaket.Fiyat.ToString("F2") ₺</strong>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-exclamation-triangle me-2"></i>Lütfen yukarıdan bir paket seçin.
                    </div>
                }

                <form asp-action="JetonSatinAl" method="post" id="odemeFormu">
                    @Html.AntiForgeryToken()
                    <input asp-for="PaketId" type="hidden" id="paketIdInput" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="KartSahibi" class="form-label fw-bold"></label>
                        <input asp-for="KartSahibi" class="form-control" placeholder="AD SOYAD" style="text-transform:uppercase" />
                        <span asp-validation-for="KartSahibi" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="KartNumarasi" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-credit-card"></i></span>
                            <input asp-for="KartNumarasi" class="form-control" placeholder="0000 0000 0000 0000"
                                   maxlength="19" id="kartNo" />
                        </div>
                        <span asp-validation-for="KartNumarasi" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-7">
                            <label asp-for="SonKullanma" class="form-label fw-bold"></label>
                            <input asp-for="SonKullanma" class="form-control" placeholder="AA/YY" maxlength="5" id="sonKullanma" />
                            <span asp-validation-for="SonKullanma" class="text-danger small"></span>
                        </div>
                        <div class="col-5">
                            <label asp-for="Cvv" class="form-label fw-bold"></label>
                            <input asp-for="Cvv" class="form-control" placeholder="•••" maxlength="3" type="password" />
                            <span asp-validation-for="Cvv" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success w-100 btn-lg" id="odemeBtn"
                            @(seciliPaket == null ? "disabled" : "")>
                        <i class="bi bi-lock-fill me-2"></i>
                        Güvenli Öde @(seciliPaket != null ? $"— {seciliPaket.Fiyat.ToString("F2")} ₺" : "")
                    </button>
                </form>

                <div class="text-center mt-3">
                    <small class="text-muted">
                        <i class="bi bi-shield-check me-1 text-success"></i>
                        256-bit SSL ile korumalı simüle ödeme sistemi
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function paketSec(id, ad, jeton, fiyat) {
            document.getElementById('paketIdInput').value = id;

            document.querySelectorAll('.card[onclick]').forEach(k => {
                k.classList.remove('border-success', 'border-3');
            });
            event.currentTarget.classList.add('border-success', 'border-3');

            const btn = document.getElementById('odemeBtn');
            btn.disabled = false;
            btn.innerHTML = `<i class="bi bi-lock-fill me-2"></i>Güvenli Öde — ${fiyat} ₺`;

            document.getElementById('odemeFormu').scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        // Kart numarası otomatik boşluk ekle
        document.getElementById('kartNo').addEventListener('input', function () {
            let val = this.value.replace(/\D/g, '').substring(0, 16);
            this.value = val.replace(/(.{4})/g, '$1 ').trim();
            // Validation için sadece rakamları hidden input'a yaz
            document.querySelector('[name="KartNumarasi"]').value = val;
        });

        // Son kullanma AA/YY formatı
        document.getElementById('sonKullanma').addEventListener('input', function () {
            let val = this.value.replace(/\D/g, '');
            if (val.length >= 2) val = val.substring(0, 2) + '/' + val.substring(2, 4);
            this.value = val;
        });
    </script>
}
