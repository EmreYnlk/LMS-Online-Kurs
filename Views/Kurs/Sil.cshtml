@model LMSPlatform.Models.Kurs
@{
    ViewData["Title"] = "Kurs Sil";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger shadow">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-trash me-2"></i>Kurs Sil</h4>
            </div>
            <div class="card-body">
                <p class="lead">Aşağıdaki kursu silmek istediğinizden emin misiniz?</p>
                <ul class="list-group mb-4">
                    <li class="list-group-item"><strong>Başlık:</strong> @Model.Baslik</li>
                    <li class="list-group-item"><strong>Kategori:</strong> @Model.Kategori?.Ad</li>
                    <li class="list-group-item"><strong>Fiyat:</strong> @(Model.Ucretsiz ? "Ücretsiz" : $"{Model.Fiyat} jeton")</li>
                </ul>
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>Bu işlem geri alınamaz. Kursa ait tüm dersler ve abonelikler de silinecektir.
                </div>
                <form asp-action="Sil" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Evet, Sil
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                </form>
            </div>
        </div>
    </div>
</div>
