@model LMSPlatform.ViewModels.KursViewModel
@{
    ViewData["Title"] = "Yeni Kurs";
}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Yeni Kurs Oluştur</h4>
            </div>
            <div class="card-body">
                <form asp-action="Olustur" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Baslik" class="form-label fw-bold"></label>
                        <input asp-for="Baslik" class="form-control" placeholder="Kurs başlığı" />
                        <span asp-validation-for="Baslik" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Aciklama" class="form-label fw-bold"></label>
                        <textarea asp-for="Aciklama" class="form-control" rows="4" placeholder="Kurs hakkında açıklama..."></textarea>
                        <span asp-validation-for="Aciklama" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="KategoriId" class="form-label fw-bold"></label>
                            <select asp-for="KategoriId" asp-items="Model.Kategoriler" class="form-select">
                                <option value="">-- Kategori Seçin --</option>
                            </select>
                            <span asp-validation-for="KategoriId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Fiyat" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <input asp-for="Fiyat" class="form-control" type="number" min="0" />
                                <span class="input-group-text"><i class="bi bi-coin"></i> jeton</span>
                            </div>
                            <small class="text-muted">0 = Ücretsiz kurs</small>
                            <span asp-validation-for="Fiyat" class="text-danger small d-block"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ResimUrl" class="form-label fw-bold"></label>
                        <input asp-for="ResimUrl" class="form-control" placeholder="https://example.com/resim.jpg" />
                        <small class="text-muted">Boş bırakabilirsiniz.</small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2 me-1"></i>Kurs Oluştur
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
