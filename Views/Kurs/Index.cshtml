@model IEnumerable<LMSPlatform.Models.Kurs>
@{
    ViewData["Title"] = "Kurslarım";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-collection-play me-2"></i>Kurslarım</h2>
    <a asp-action="Olustur" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Yeni Kurs
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Henüz kurs oluşturmadınız.
        <a asp-action="Olustur" class="alert-link">İlk kursunuzu oluşturun.</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Başlık</th>
                    <th>Kategori</th>
                    <th>Fiyat</th>
                    <th>Abone</th>
                    <th>Tarih</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kurs in Model)
                {
                    <tr>
                        <td><strong>@kurs.Baslik</strong></td>
                        <td><span class="badge bg-secondary">@kurs.Kategori?.Ad</span></td>
                        <td>
                            @if (kurs.Ucretsiz)
                            {
                                <span class="badge bg-success">Ücretsiz</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@kurs.Fiyat jeton</span>
                            }
                        </td>
                        <td><i class="bi bi-people me-1"></i>@kurs.AbonelikSayisi</td>
                        <td>@kurs.OlusturmaTarihi.ToString("dd.MM.yyyy")</td>
                        <td>
                            <a asp-action="Detay" asp-route-id="@kurs.Id" class="btn btn-sm btn-outline-info">Detay</a>
                            <a asp-controller="Ders" asp-action="Index" asp-route-kursId="@kurs.Id" class="btn btn-sm btn-outline-secondary">Dersler</a>
                            <a asp-action="Duzenle" asp-route-id="@kurs.Id" class="btn btn-sm btn-outline-warning">Düzenle</a>
                            <a asp-action="Sil" asp-route-id="@kurs.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
