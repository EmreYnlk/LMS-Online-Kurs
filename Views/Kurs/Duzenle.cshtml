@model LMSPlatform.ViewModels.KursViewModel
@{
    ViewData["Title"] = "Kurs Düzenle";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="page-header animate-fade-up">
            <div class="page-header-left">
                <h2><i class="bi bi-pencil-square me-2" style="color:var(--secondary);font-size:1.4rem;"></i>Kurs Düzenle</h2>
                <p>Kurs bilgilerini güncelleyin</p>
            </div>
        </div>

        <div class="card animate-fade-up-delay-1" style="overflow:hidden;">
            <div class="card-body" style="padding:2rem;">
                <form asp-action="Duzenle" asp-route-id="@Model.Id" method="post" id="duzenleForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                    <div class="mb-4">
                        <label asp-for="Baslik" class="form-label">
                            <i class="bi bi-pencil me-1" style="color:var(--secondary);"></i>Kurs Başlığı
                        </label>
                        <input asp-for="Baslik" class="form-control" />
                        <span asp-validation-for="Baslik" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Aciklama" class="form-label">
                            <i class="bi bi-text-paragraph me-1" style="color:var(--secondary);"></i>Açıklama
                        </label>
                        <textarea asp-for="Aciklama" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Aciklama" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="KategoriId" class="form-label">
                                <i class="bi bi-grid me-1" style="color:var(--secondary);"></i>Kategori
                            </label>
                            <select asp-for="KategoriId" asp-items="Model.Kategoriler" class="form-select"></select>
                            <span asp-validation-for="KategoriId" class="text-danger" style="font-size:0.78rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Fiyat" class="form-label">
                                <i class="bi bi-coin me-1" style="color:var(--secondary);"></i>Fiyat
                            </label>
                            <div style="display:flex;gap:0.5rem;align-items:center;">
                                <input asp-for="Fiyat" class="form-control" type="number" min="0" />
                                <span style="background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.2);color:var(--secondary);padding:0.65rem 1rem;border-radius:var(--radius-sm);white-space:nowrap;font-size:0.85rem;font-weight:600;">
                                    <i class="bi bi-coin me-1"></i>Jeton
                                </span>
                            </div>
                            <p class="form-text mt-1">0 = Ücretsiz kurs</p>
                        </div>
                    </div>

                    <div class="mb-5">
                        <label asp-for="ResimUrl" class="form-label">
                            <i class="bi bi-image me-1" style="color:var(--secondary);"></i>Kapak Görseli URL
                        </label>
                        <input asp-for="ResimUrl" class="form-control" placeholder="https://..." />
                        <p class="form-text mt-1">Boş bırakırsanız mevcut görsel korunur</p>
                    </div>

                    <div style="display:flex;gap:0.75rem;flex-wrap:wrap;padding-top:1.5rem;border-top:1px solid var(--border);">
                        <button type="submit" class="btn btn-warning btn-lg">
                            <i class="bi bi-check2-circle me-2"></i>Değişiklikleri Kaydet
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-x me-1"></i>İptal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
