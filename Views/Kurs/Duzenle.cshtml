@model LMSPlatform.ViewModels.KursViewModel
@{
    ViewData["Title"] = "Kurs Düzenle";
}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-warning">
                <h4 class="mb-0"><i class="bi bi-pencil me-2"></i>Kurs Düzenle</h4>
            </div>
            <div class="card-body">
                <form asp-action="Duzenle" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Baslik" class="form-label fw-bold"></label>
                        <input asp-for="Baslik" class="form-control" />
                        <span asp-validation-for="Baslik" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Aciklama" class="form-label fw-bold"></label>
                        <textarea asp-for="Aciklama" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Aciklama" class="text-danger small"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="KategoriId" class="form-label fw-bold"></label>
                            <select asp-for="KategoriId" asp-items="Model.Kategoriler" class="form-select"></select>
                            <span asp-validation-for="KategoriId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Fiyat" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <input asp-for="Fiyat" class="form-control" type="number" min="0" />
                                <span class="input-group-text"><i class="bi bi-coin"></i></span>
                            </div>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ResimUrl" class="form-label fw-bold"></label>
                        <input asp-for="ResimUrl" class="form-control" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-check2 me-1"></i>Güncelle
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
